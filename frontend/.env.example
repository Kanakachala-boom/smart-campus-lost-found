# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and must never be committed.

# Base URL of the future FastAPI backend, with no trailing slash.
# Example for local development: http://localhost:8000
VITE_API_BASE_URL=

# Use the isolated mock service layer instead of calling the real backend.
# Set to "false" once the FastAPI endpoints exist.
VITE_USE_MOCK=true
